<Project>
  <PropertyGroup>
    <Authors>MyraTeam</Authors>
    <Product>Myra</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rds1983/Myra</PackageProjectUrl>
    <RootNamespace>Myra</RootNamespace>
    <Description>UI Library for MonoGame, FNA and Stride</Description>
    <VersionPrefix>1.6.8</VersionPrefix>
    <AMBVersion>0.7.4</AMBVersion>
    <FontStashSharpVersion>1.6.1</FontStashSharpVersion>
    <XNAssetsVersion>0.8.9</XNAssetsVersion>
    <MonoGameVersion>3.8.0.1641</MonoGameVersion>
    <AppMonoGameVersion>3.8.5.1</AppMonoGameVersion>
    <StrideVersion>4.4.0</StrideVersion>
    <AppTargetFramework>net10.0</AppTargetFramework>
  </PropertyGroup>
</Project>